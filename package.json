{
  "name": "nitro-drizzle",
  "version": "0.3.0-beta.6",
  "description": "Nitro module to integrate Drizzle ORM with ease.",
  "homepage": "https://github.com/myshkouski/nitro-drizzle#readme",
  "bugs": {
    "url": "https://github.com/myshkouski/nitro-drizzle/issues"
  },
  "license": "MIT",
  "author": "Alexei Myshkouski <alexeimyshkouski@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myshkouski/nitro-drizzle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./shared": "./dist/shared.mjs",
    "./migrations": "./dist/migrations.mjs",
    "./migrations/task": "./dist/migrations/task.mjs",
    "./config": "./dist/config.mjs",
    "./context": "./dist/context.mjs",
    "./dialects": "./dist/dialects/index.mjs",
    "./dialects/*": "./dist/dialects/*.mjs",
    "./drivers": "./dist/drivers/index.mjs",
    "./drivers/*": "./dist/drivers/*.mjs",
    "./meta": "./dist/meta.mjs",
    "./module": "./dist/module.mjs",
    "./middleware/*": "./dist/middleware/*.mjs",
    "./plugins/*": "./dist/plugins/*.mjs",
    "./plugins/legacy/*": "./dist/plugins/legacy/*.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "playground": "nitro dev playground",
    "test:dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "changelogen --release"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "c12": "^3.3.4",
    "consola": "^3.4.2",
    "db0": "^0.3.4",
    "defu": "^6.1.7",
    "jiti": "^2.7.0",
    "knitwork": "^1.3.0",
    "nitro": "catalog:",
    "nitropack": "catalog:",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "rollup": "^4.62.4",
    "strip-indent": "^4.1.1",
    "tinyglobby": "^0.2.17",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@testcontainers/mysql": "catalog:testcontainers",
    "@testcontainers/postgresql": "catalog:testcontainers",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "changelogen": "^0.6.2",
    "lefthook": "^2.1.10",
    "listhen": "^1.10.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "testcontainers": "catalog:testcontainers",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unplugin-unused": "^0.5.7",
    "vitest": "^4.1.10",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:drivers",
    "@electric-sql/pglite": "catalog:drivers",
    "better-sqlite3": "catalog:drivers",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "catalog:",
    "mysql2": "catalog:drivers",
    "postgres": "catalog:drivers",
    "srvx": "^0.12.5"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
